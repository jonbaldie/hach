{"label": "coding-result-file", "content": "import re\n\n\ndef slugify(text):\n    \"\"\"Convert text to a lowercase ASCII slug.\"\"\"\n    return re.sub(r\"[^a-z0-9]+\", \"-\", text.lower()).strip(\"-\")\n"}
